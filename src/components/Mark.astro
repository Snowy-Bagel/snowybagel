---
// The Snowy Bagel mark: a bagel ring whose "seeds" are a dusting of snow.
interface Props {
  size?: number | string;
  class?: string;
  title?: string;
}
const { size = 32, class: className, title } = Astro.props;

// [x, y, rotation] — seeds sit on the upper half of the ring, like settled snow.
const seeds = [
  [50, 15, 0],
  [33, 20, -32],
  [67, 20, 32],
  [21, 33, -58],
  [79, 33, 58],
  [42, 27, 20],
  [58, 27, -20],
  [15, 48, -84],
  [85, 48, 84],
  [28, 44, -40],
  [72, 44, 40],
];
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
  aria-label={title}
>
  <circle cx="50" cy="50" r="33" fill="none" stroke="currentColor" stroke-width="30"></circle>
  <g fill="var(--mark-seed, #fff)">
    {
      seeds.map(([x, y, r]) => (
        <ellipse cx={x} cy={y} rx="3.1" ry="1.5" transform={`rotate(${r} ${x} ${y})`} />
      ))
    }
  </g>
</svg>
